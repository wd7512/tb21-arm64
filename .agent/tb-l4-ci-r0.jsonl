ss.\n+\n ## Use with harbor-research-runner\n \n Point the job file's task source at a commit of this repository:\ndiff --git a/checks/test_ci_tasks.py b/checks/test_ci_tasks.py\nnew file mode 100644\nindex 0000000..0cae3e0\n--- /dev/null\n+++ b/checks/test_ci_tasks.py\n@@ -0,0 +1,68 @@\n+import importlib.util\n+import subprocess\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+SPEC = importlib.util.spec_from_file_location(\"ci_tasks\", ROOT / \"tools\" / \"ci_tasks.py\")\n+ci_tasks = importlib.util.module_from_spec(SPEC)\n+SPEC.loader.exec_module(ci_tasks)\n+\n+\n+def manifest():\n+    return {\n+        \"tasks\": {\n+            \"task-one\": {\"status\": \"untested\"},\n+            \"task-skipped\": {\"status\": \"skipped\"},\n+            \"task-no-status\": {},\n+            \"break-filter-js-from-html\": {\"status\": \"untested\"},\n+            \"mteb-retrieve\": {\"status\": \"untested\"},\n+            \"regex-log\": {\"status\": \"untested\"},\n+        }\n+    }\n+\n+\n+def changed(paths):\n+    def run(command, **kwargs):\n+        assert command == [\"git\", \"diff\", \"--name-only\", \"base...HEAD\"]\n+        return subprocess.CompletedProcess(command, 0, stdout=\"\\n\".join(paths) + \"\\n\")\n+\n+    return run\n+\n+\n+def test_task_change_selects_manifest_task():\n+    assert ci_tasks.tasks_for_changed(manifest(), \"base\", run=changed([\"task-one/task.toml\"])) == [\n+        \"task-one\"\n+    ]\n+\n+def test_tools_only_change_uses_canary_set():\n+    assert ci_tasks.tasks_for_changed(manifest(), \"base\", run=changed([\"tools/build.sh\"])) == [\n+        \"break-filter-js-from-html\",\n+        \"mteb-retrieve\",\n+        \"regex-log\",\n+    ]\n+\n+\n+def test_docs_only_change_is_empty():\n+    assert ci_tasks.tasks_for_changed(manifest(), \"base\", run=changed([\"README.md\"])) == []\n+\n+\n+def test_skipped_task_is_excluded():\n+    assert ci_tasks.tasks_for_changed(\n+        manifest(), \"base\", run=changed([\"task-skipped/task.toml\"])\n+    ) == []\n+\n+\n+def test_unknown_folder_is_ignored():\n+    assert ci_tasks.tasks_for_changed(\n+        manifest(), \"base\", run=changed([\"not-a-task/task.toml\"])\n+    ) == []\n+\n+\n+def test_all_includes_missing_status_but_not_skipped():\n+    assert ci_tasks.tasks_for_all(manifest()) == [\n+        \"break-filter-js-from-html\",\n+        \"mteb-retrieve\",\n+        \"regex-log\",\n+        \"task-no-status\",\n+        \"task-one\",\n+    ]\ndiff --git a/tools/ci_tasks.py b/tools/ci_tasks.py\nnew file mode 100644\nindex 0000000..f5c10c6\n--- /dev/null\n+++ b/tools/ci_tasks.py\n@@ -0,0 +1,60 @@\n+\"\"\"Select task folders for the CI matrix.\"\"\"\n+\n+import argparse\n+import json\n+import subprocess\n+import sys\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+CANARIES = [\"break-filter-js-from-html\", \"mteb-retrieve\", \"regex-log\"]\n+MATRIX_PATHS = (\"tools/\", \"manifest.json\", \"pyproject.toml\", \".github/\")\n+\n+\n+def tasks_for_all(manifest):\n+    return sorted(\n+        task for task, row in manifest[\"tasks\"].items() if row.get(\"status\") != \"skipped\"\n+    )\n+\n+\n+def tasks_for_changed(manifest, base, *, run=subprocess.run):\n+    result = run(\n+        [\"git\", \"diff\", \"--name-only\", f\"{base}...HEAD\"],\n+        check=True,\n+        capture_output=True,\n+        text=True,\n+        cwd=ROOT,\n+    )\n+    paths = [line for line in result.stdout.splitlines() if line]\n+    manifest_tasks = manifest[\"tasks\"]\n+    selected = {\n+        path.split(\"/\", 1)[0]\n+        for path in paths\n+        if \"/\" in path\n+        and path.split(\"/\", 1)[0] in manifest_tasks\n+        and manifest_tasks[path.split(\"/\", 1)[0]].get(\"status\") != \"skipped\"\n+    }\n+    if not selected and any(\n+        path.startswith(\"tools/\")\n+        or path in MATRIX_PATHS[1:3]\n+        or path.startswith(\".github/\")\n+        for path in paths\n+    ):\n+        selected.update(task for task in CANARIES if task in manifest_tasks)\n+    return sorted(selected)\n+\n+\n+def main(argv=None):\n+    parser = argparse.ArgumentParser(description=__doc__)\n+    selection = parser.add_mutually_exclusive_group(required=True)\n+    selection.add_argument(\"--all\", action=\"store_true\", help=\"select every non-skipped task\")\n+    selection.add_argument(\"--changed\", metavar=\"BASE\", help=\"select tasks changed from BASE\")\n+    args = parser.parse_args(argv)\n+    manifest = json.loads((ROOT / \"manifest.json\").read_text(encoding=\"utf-8\"))\n+    tasks = tasks_for_all(manifest) if args.all else tasks_for_changed(manifest, args.changed)\n+    print(json.dumps(tasks))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\n","exit_code":0,"status":"completed"}}
