{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' tools/sweep.py && sed -n '1,120p' tools/test_task.py\"","aggregated_output":"\"\"\"Build and test many tasks, writing OUT/<task>.sweep.json; tasks that have one are skipped.\"\"\"\n\nimport argparse\nimport importlib.util\nimport json\nimport subprocess\nimport sys\nimport time\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nMULTI_ARCH_TYPES = {\n    \"application/vnd.oci.image.index.v1+json\",\n    \"application/vnd.docker.distribution.manifest.list.v2+json\",\n}\n\n\ndef _load_test_task():\n    spec = importlib.util.spec_from_file_location(\"test_task\", ROOT / \"tools\" / \"test_task.py\")\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module.run_test\n\n\ndef image_for(task, manifest):\n    upstream = manifest[\"tasks\"][task][\"upstream\"]\n    if upstream[\"media_type\"] in MULTI_ARCH_TYPES:\n        return f\"{upstream['image'].rsplit(':', 1)[0]}@{upstream['image_digest']}\", \"upstream\"\n    return f\"tb21-arm64-local/{task}:sweep\", \"build\"\n\n\ndef sweep_one(\n    task, manifest, out, *, run=subprocess.run, test=None, runs=3, prune=False, jobs_dir=None\n):\n    test = test or _load_test_task()\n    image, source = image_for(task, manifest)\n    started = time.monotonic()\n    out.mkdir(parents=True, exist_ok=True)\n    with (out / f\"{task}.log\").open(\"w\", encoding=\"utf-8\") as log:\n\n        def logged(command, check=False, **kwargs):\n            return run(command, check=check, stdout=log, stderr=subprocess.STDOUT)\n\n        if source == \"build\":\n            prepare = [\"bash\", str(ROOT / \"tools\" / \"build.sh\"), task, image]\n        else:\n            prepare = [\"docker\", \"pull\", \"--platform\", \"linux/arm64\", image]\n        returncode = logged(prepare).returncode\n        if returncode != 0:\n            verdict, reason = \"failing\", f\"{source} exit {returncode}\"\n        else:\n            try:\n                report = test(\n                    task,\n                    image,\n                    runs=runs,\n                    out=out / f\"{task}.test.json\",\n                    jobs_dir=jobs_dir or out / \"jobs\",\n                    run=logged,\n                )\n                verdict, reason = report[\"verdict\"], report[\"reason\"]\n            except SystemExit as error:\n                verdict, reason = \"failing\", f\"test exit {error.code}\"\n        if prune and source == \"build\":\n            logged([\"docker\", \"image\", \"rm\", image])\n    row = {\n        \"task\": task,\n        \"image\": image,\n        \"source\": source,\n        \"verdict\": verdict,\n        \"reason\": reason,\n        \"seconds\": round(time.monotonic() - started),\n    }\n    (out / f\"{task}.sweep.json\").write_text(json.dumps(row, indent=2) + \"\\n\", encoding=\"utf-8\")\n    print(f\"{task}\\t{source}\\t{verdict}\\t{reason or ''}\\t{row['seconds']}s\", flush=True)\n    return row\n\n\ndef sweep(tasks, manifest, out, *, jobs=1, **kwargs):\n    pending = [task for task in tasks if not (out / f\"{task}.sweep.json\").exists()]\n    with ThreadPoolExecutor(max_workers=jobs) as pool:\n        return list(pool.map(lambda task: sweep_one(task, manifest, out, **kwargs), pending))\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"tasks\", nargs=\"*\", help=\"default: every task in manifest.json\")\n    parser.add_argument(\"--jobs\", type=int, default=1)\n    parser.add_argument(\"--runs\", type=int, default=3)\n    parser.add_argument(\"--out\", default=str(ROOT / \"reports\" / \"local\" / \"sweep\"))\n    parser.add_argument(\"--jobs-dir\", help=\"Harbor job folders (default: OUT/jobs)\")\n    parser.add_argument(\n        \"--prune\", action=\"store_true\", help=\"remove each built image after its test\"\n    )\n    args = parser.parse_args(argv)\n    manifest = json.loads((ROOT / \"manifest.json\").read_text(encoding=\"utf-8\"))\n    unknown = sorted(set(args.tasks) - set(manifest[\"tasks\"]))\n    if unknown:\n        parser.error(f\"unknown tasks: {' '.join(unknown)}\")\n    tasks = args.tasks or sorted(manifest[\"tasks\"])\n    rows = sweep(\n        tasks,\n        manifest,\n        Path(args.out).resolve(),\n        jobs=args.jobs,\n        runs=args.runs,\n        prune=args.prune,\n        jobs_dir=Path(args.jobs_dir).resolve() if args.jobs_dir else None,\n    )\n    return 0 if all(row[\"verdict\"] == \"verified\" for row in rows) else 1\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\"\"\"Build-independent Harbor oracle and nop verification for a local task image.\"\"\"\n\nimport argparse\nimport json\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport tomllib\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[1]\nHARBOR_VERSION = \"0.23.0\"\n\n\ndef _task_folder(task):\n    if Path(task).name != task or Path(task).is_absolute():\n        raise ValueError(f\"task must be a root folder containing task.toml: {task}\")\n    folder = ROOT / task\n    if not folder.is_dir() or not (folder / \"task.toml\").is_file():\n        raise ValueError(f\"task must be a root folder containing task.toml: {task}\")\n    return folder\n\n\ndef _copy_with_image(task_folder, image, temp_root):\n    copied_task = temp_root / task_folder.name\n    shutil.copytree(task_folder, copied_task)\n    config = copied_task / \"task.toml\"\n    content = config.read_text(encoding=\"utf-8\")\n    rewritten, count = re.subn(\n        r'(?m)^(\\s*docker_image\\s*=\\s*)\"[^\"\\n]*\"(\\s*(?:#.*)?)$',\n        lambda match: f\"{match.group(1)}{json.dumps(image)}{match.group(2)}\",\n        content,\n    )\n    if count != 1:\n        raise ValueError(f\"expected one docker_image setting in {config}, found {count}\")\n    config.write_text(rewritten, encoding=\"utf-8\")\n    parsed = tomllib.loads(rewritten)\n    if parsed[\"environment\"][\"docker_image\"] != image:\n        raise ValueError(\"rewritten docker_image does not match requested image\")\n    return copied_task\n\n\ndef _run_harbor(task_folder, agent, jobs_dir, job_name, run):\n    command = [\n        \"uvx\",\n        \"--from\",\n        f\"harbor=={HARBOR_VERSION}\",\n        \"harbor\",\n        \"run\",\n        \"-p\",\n        str(task_folder),\n        \"-a\",\n        agent,\n        \"-e\",\n        \"docker\",\n        \"-o\",\n        str(jobs_dir),\n        \"--job-name\",\n        job_name,\n        \"-y\",\n        \"-q\",\n    ]\n    run(command, check=False)\n    results = list((jobs_dir / job_name).glob(\"*/result.json\"))\n    if len(results) != 1:\n        raise SystemExit(2)\n    result = json.loads(results[0].read_text(encoding=\"utf-8\"))\n    exception_info = result.get(\"exception_info\")\n    exception_type = exception_info.get(\"exception_type\") if exception_info else None\n    verifier_result = result.get(\"verifier_result\")\n    reward = None\n    if verifier_result is not None:\n        reward = verifier_result.get(\"rewards\", {}).get(\"reward\")\n    return {\"reward\": reward, \"exception_type\": exception_type, \"job\": job_name}\n\n\ndef run_test(task, image, runs=3, out=None, jobs_dir=None, run=subprocess.run):\n    task_folder = _task_folder(task)\n    if runs < 1:\n        raise ValueError(\"runs must be at least 1\")\n    jobs_dir = Path(jobs_dir) if jobs_dir is not None else ROOT / \"jobs\"\n    out = Path(out) if out is not None else ROOT / \"reports\" / \"local\" / f\"{task}.test.json\"\n    jobs_dir = jobs_dir.resolve()\n    stamp = datetime.now(UTC).strftime(\"%Y%m%dT%H%M%S\")\n    oracle = []\n    with tempfile.TemporaryDirectory(prefix=\"tb21-test-task-\") as temporary:\n        copied_task = _copy_with_image(task_folder, image, Path(temporary))\n        for index in range(1, runs + 1):\n            job_name = f\"{task}-oracle-{index}-{stamp}\"\n            oracle.append(_run_harbor(copied_task, \"oracle\", jobs_dir, job_name, run))\n        nop_name = f\"{task}-nop-{stamp}\"\n        nop = _run_harbor(copied_task, \"nop\", jobs_dir, nop_name, run)\n\n    reason = None\n    for index, result in enumerate(oracle, start=1):\n        if result[\"exception_type\"]:\n            reason = f\"oracle run {index} exception {result['exception_type']}\"\n            break\n        if result[\"reward\"] != 1.0:\n            reason = f\"oracle run {index} reward {result['reward']}\"\n            break\n    if reason is None:\n        if nop[\"exception_type\"]:\n            reason = f\"nop exception {nop['exception_type']}\"\n        elif nop[\"reward\"] != 0.0:\n            reason = f\"nop reward {nop['reward']}\"\n\n    report = {\n        \"task\": task,\n        \"image\": image,\n        \"harbor\": HARBOR_VERSION,\n        \"oracle\": oracle,\n        \"nop\": nop,\n        \"verdict\": \"verified\" if reason is None else \"failing\",\n        \"reason\": reason,\n        \"finished_at\": datetime.now(UTC).isoformat(),\n    }\n","exit_code":0,"status":"completed"}}
