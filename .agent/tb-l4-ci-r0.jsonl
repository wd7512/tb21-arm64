matrix.json\n+          else\n+            printf '[]\\n' > task-matrix.json\n+          fi\n+          echo \"tasks=$(cat task-matrix.json)\" >> \"$GITHUB_OUTPUT\"\n+\n+  task:\n+    needs: plan\n+    if: needs.plan.outputs.tasks != '[]'\n+    runs-on: ubuntu-24.04-arm\n+    strategy:\n+      fail-fast: false\n+      max-parallel: 20\n+      matrix:\n+        task: ${{ fromJSON(needs.plan.outputs.tasks) }}\n+    timeout-minutes: 240\n+    steps:\n+      - name: Free disk space\n+        run: |\n+          df -h /\n+          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL\n+          docker system prune -af\n+          df -h /\n+      - uses: actions/checkout@v4.2.2\n+      - uses: astral-sh/setup-uv@v6.6.1\n+      - name: Build and verify task\n+        run: uv run python tools/sweep.py \"${{ matrix.task }}\" --out reports/ci\n+      - uses: actions/upload-artifact@v4.6.2\n+        if: always()\n+        with:\n+          name: task-${{ matrix.task }}\n+          path: |\n+            reports/ci/*.json\n+            reports/ci/*.log\n+          if-no-files-found: ignore\n+          retention-days: 14\n+\n+  publish:\n+    needs: [plan, task]\n+    if: github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.TB21_PUBLISH == 'true' && needs.task.result == 'success' && needs.plan.outputs.tasks != '[]'\n+    runs-on: ubuntu-24.04-arm\n+    permissions:\n+      contents: read\n+      packages: write\n+    strategy:\n+      fail-fast: false\n+      max-parallel: 20\n+      matrix:\n+        task: ${{ fromJSON(needs.plan.outputs.tasks) }}\n+    steps:\n+      - uses: actions/checkout@v4.2.2\n+      - uses: astral-sh/setup-uv@v6.6.1\n+      - name: Skip upstream multi-architecture images\n+        if: contains(fromJSON('[\"hf-model-inference\",\"mteb-leaderboard\",\"mteb-retrieve\",\"pytorch-model-recovery\"]'), matrix.task)\n+        run: echo \"This task uses the upstream multi-architecture image.\"\n+      - name: