{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat pyproject.toml'","aggregated_output":"[project]\nname = \"tb21-arm64\"\nversion = \"0.0.0\"\ndescription = \"Native arm64 images and task folders for Terminal-Bench 2.1\"\nrequires-python = \">=3.12\"\nlicense = \"Apache-2.0\"\ndependencies = []\n\n[dependency-groups]\ndev = [\n    \"pytest==9.1.1\",\n    \"ruff==0.16.5\",\n    \"shellcheck-py==0.11.0.1\",\n    \"wills-agentic-tools\",\n]\n\n[tool.uv]\npackage = false\n\n[tool.uv.sources]\nwills-agentic-tools = { git = \"https://github.com/wd7512/wills-agentic-tools\", tag = \"v0.2.1\" }\n\n[tool.ruff]\nline-length = 100\ntarget-version = \"py312\"\nextend-exclude = [\"*/environment\", \"*/solution\", \"*/tests\"]\n\n[tool.ruff.lint]\nselect = [\"E\", \"F\", \"I\", \"B\", \"UP\"]\n\n[tool.pytest.ini_options]\ntestpaths = [\"checks\"]\n\n[tool.devtools.delegate]\ngate_command = \"sh -c 'uv run ruff check tools checks && uv run ruff format --check tools checks && uv run pytest -q && { set -- tools/*.sh tools/*.sbatch; [ ! -e \\\"$1\\\" ] || uv run shellcheck \\\"$@\\\"; }'\"\nbase = \"origin/main\"\nextra_rules = [\n    \"Read `AGENTS.md` and your brief before anything else. If they disagree, or the brief is wrong about existing files, stop and report.\",\n    \"Make no design decisions. A missing detail is a reason to stop and report, not to choose.\",\n    \"Never edit a task folder unless the brief names it; task folders are benchmark content.\",\n    \"Do not add a dependency, a command-line flag, an environment variable or a file format field that the brief does not name.\",\n    \"Never push images or contact a registry except to pull public images.\",\n]\n","exit_code":0,"status":"completed"}}
